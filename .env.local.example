NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...
NEXT_PUBLIC_AFFILIATE_TAG=YOURAPP-21

# YouTube Data API v3 — required for video review upload/delete (/admin/videos).
# Missing: video upload fails silently; admin cannot add or remove video reviews.
# Get credentials at console.cloud.google.com → APIs & Services → Credentials.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# OneSignal push notifications — required for price-drop alerts and review notifications.
# Missing: push notifications are silently skipped; users never receive alerts.
# Get credentials at app.onesignal.com → your app → Keys & IDs.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
